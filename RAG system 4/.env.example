# System 4 configuration — copy to .env and adjust.
# Local-first by default: no transcript content leaves the machine unless you
# explicitly opt in with SYSTEM4_ALLOW_REMOTE=1 (AGENTS_SYSTEM_4.md §41).

# --- Local LLM: Ollama (preferred) -----------------------------------------
OLLAMA_URL=http://localhost:11434
# Leave empty for the deterministic evidence-cited fallback generator.
OLLAMA_MODEL=

# --- Local LLM: Bonsai endpoint --------------------------------------------
# Used when OLLAMA_MODEL is empty and BONSAI_URL is set.
BONSAI_URL=
BONSAI_MODEL=

# --- Approved cloud endpoint (OpenAI-compatible: Groq, OpenAI, ...) --------
# Requires SYSTEM4_ALLOW_REMOTE=1, otherwise the pipeline stays local.
CLOUD_URL=
CLOUD_API_KEY=
CLOUD_MODEL=
SYSTEM4_ALLOW_REMOTE=

# --- Jev-compatible decision endpoint (optional; local-first fallback) -----
JEV_ENDPOINT=

# --- Runtime ---------------------------------------------------------------
# Index artifact used by the Streamlit app and scripts.
SYSTEM4_INDEX=artifacts/index.pkl
# Structured request traces (ids/scores/counts only — never transcript text).
SYSTEM4_TRACE_DIR=artifacts/traces
