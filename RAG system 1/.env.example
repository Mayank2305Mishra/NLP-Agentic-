# Copy to .env and adjust. Never commit .env with secrets.
# Source dataset (auto-detected if left empty: final_transcript.json, then final_transcripts.json)
SOURCE_PATH=
# Generated artifacts
GENERATED_DIR=generated
# Embeddings: backend=hashing (default, local, no download) | sentence-transformers (optional)
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=hashing-768
EMBEDDING_DIM=768
EMBEDDING_NORMALIZE=true
MAX_EMBEDDING_BATCH=32
# Vector store: auto | faiss | numpy
VECTOR_STORE_TYPE=auto
# Chunking
CHUNK_TARGET_TOKENS=450
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TURNS=2
CHUNK_INCLUDE_METADATA=true
# Retrieval / evidence
RETRIEVAL_TOP_K=8
EVIDENCE_TOP_K=8
EVIDENCE_MAX_PER_TRANSCRIPT=3
EVIDENCE_MAX_CONTEXT_TOKENS=6000
# System-1 Laya (local decision layer; no network)
LAYA_ENABLED=true
LAYA_MODE=local
LAYA_ALLOW_DEGRADED=true
# Generation: local Ollama — the sole generator. Nothing leaves the laptop.
# Model must be pulled: ollama pull qwen3.5:4b-mlx
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b-mlx
GENERATION_TIMEOUT_SECONDS=180
GENERATION_CONNECT_TIMEOUT_SECONDS=5
GENERATION_MAX_RETRIES=2
GENERATION_TEMPERATURE=0.0
GENERATION_TOP_P=1.0
GENERATION_MAX_TOKENS=2000
MAX_GENERATION_CONCURRENCY=1
# Prompts
PROMPT_VERSION_TASK1=v3
PROMPT_VERSION_TASK2=v1
# Runtime
APP_DEBUG=false
ALLOW_STALE_INDEX=false
LOG_LEVEL=INFO
